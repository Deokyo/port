# ---------------------------------------------------------------------------
# Programa WIN — exemplo de configuracao. NENHUM VALOR REAL AQUI.
# Copie para .env e preencha localmente. .env NUNCA vai para o repositorio.
# ---------------------------------------------------------------------------

# development | test | staging | production
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Fuso horario de negocio. Timestamps sao gravados em UTC e convertidos aqui.
APP_TIMEZONE=America/Sao_Paulo

# --- Banco de dados --------------------------------------------------------
# development/test: "pglite" sobe um PostgreSQL embarcado, sem servidor.
# staging/production: obrigatoriamente "pg" com DATABASE_URL apontando para um
# usuario que NAO seja owner do banco (ver docs/SEGURANCA_E_PRIVACIDADE.md).
DB_DRIVER=pglite
DB_PGLITE_PATH=.pgdata/win
# DATABASE_URL=postgres://win_app:__TROQUE__@localhost:5432/programa_win

# --- Sessao ----------------------------------------------------------------
# Minimo 32 caracteres. Gere com: openssl rand -base64 48
SESSION_SECRET=__DEFINA_UM_SEGREDO_LOCAL_COM_AO_MENOS_32_CARACTERES__
SESSION_TTL_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- OIDC (provedor corporativo ainda NAO informado — D-02/B2) --------------
# Enquanto vazio, o login OIDC responde 503 e /admin permanece inacessivel.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_PATH=/auth/oidc/callback

# --- Bootstrap do primeiro administrador (inativo por padrao) --------------
# Só funciona com OIDC configurado. Gere um token de uso unico e descarte-o.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_TOKEN=

# --- Importacao ------------------------------------------------------------
IMPORT_MAX_UPLOAD_BYTES=10485760
IMPORT_MAX_UNCOMPRESSED_BYTES=52428800
IMPORT_MAX_ROWS=20000

# --- Limites e observabilidade --------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info

# --- Aprovador das decisoes de negocio ------------------------------------
# Nome de quem responde pelas decisoes tomadas FORA do documento assinado
# (pontuacao, titularidade, sequencia de etapas, modelo operacional).
# Sem este valor essas regras permanecem 'proposed' e as funcionalidades que
# dependem delas ficam DESLIGADAS — por design: o registro nao grava aprovacao
# anonima. Preencha com o nome da pessoa responsavel, nao com um cargo.
WIN_DECISION_APPROVER=

# --- Somente testes automatizados -----------------------------------------
# A aplicacao RECUSA iniciar se isto estiver ligado fora de NODE_ENV=test.
AUTH_TEST_MODE=false
